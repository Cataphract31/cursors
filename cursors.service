# CURSORS.EXE, on the box.
#
#   sudo cp cursors.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart cursors
#   journalctl -fu cursors
#
# This unit was hand-written on the machine and existed nowhere else, which
# meant a box rebuild lost it and nobody could review what the live server was
# actually being told. It is in the repository now.
#
# Its Description used to end "(play money)". It did, in a `players.balance`
# REAL column moved single-sided by `p.balance -= STAKE`. That column is gone
# and the money is the arcade's; the description would otherwise be the only
# thing on the box still saying otherwise.

[Unit]
Description=CURSORS.EXE -- deploy-and-bank server
# The arcade holds the books this game moves money in, and this process fails
# closed without them: it wants gielinor up, but does not require it, because a
# ledger that is briefly down should mean "no deploys for a minute" and not "the
# game server is also down and takes a manual restart".
After=network-online.target gielinor.service
Wants=network-online.target gielinor.service

[Service]
Type=simple
User=cursors
# /opt/cursors is a CLONE OF THIS REPOSITORY, and the server lives one level
# down in it. It used to be a flat copy of server/ with no .git, which meant the
# deploy was an scp somebody remembered the shape of -- there was no way to ask
# the box what it was running. `git pull` is the deploy now, the same as the
# arcade's.
WorkingDirectory=/opt/cursors/server
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# A 1 GB box running three services. The corpse ring is the memory this game
# actually spends, and CORPSES is the lever if this cap is ever hit.
MemoryMax=220M

Environment=NODE_ENV=production
Environment=PORT=8788
Environment=DB_PATH=/var/lib/cursors/cursors.db
Environment=CORPSES=900

# -- the arcade's books ------------------------------------------------------
#
# LEDGER_KEY, ARCADE_LEDGER_URL and ARCADE_AUTH_URL, in ONE file shared with
# gielinor.service and thinice.service. See the long note in gielinor.service:
# the key is the whole authority to move anybody's money on this box, and three
# copies of it is not a filing problem but a rotation hazard.
#
# ARCADE_AUTH_URL is what turns a session token into the wallet that signed for
# it. It is the ONLY route a wallet identity enters this process -- a client
# claiming to be an address proves nothing, so server.js asks the arcade and
# believes only the answer.
#
# THE URLS ARE LOOPBACK AND MUST STAY LOOPBACK: server/ledger.js refuses to
# start if LEDGER_KEY is set and the ledger URL is not on 127.0.0.1.
#
# No `-` prefix: a missing file must stop this unit rather than bring up a
# server that looks healthy and refuses every deploy.
EnvironmentFile=/etc/arcade/arcade.env

# The database is this game's own -- cursors, epochs, chat. Not money.
StateDirectory=cursors
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

# WHAT THIS PROCESS MAY DO, WHICH IS NEARLY NOTHING.
#
# Matched to gielinor.service, which is the unit these three sit beside on the
# same box. The reasoning is written out there in full; the short version is that
# a process which answers HTTP and writes one database has no business reaching
# any of the below, and a compromised Node process is exactly what this bounds.

# ITS OWN DATABASE IS NOT WORLD-READABLE. Without UMask= a service inherits 0022,
# so node creates the database 0644 -- readable by every other account on this
# box, including the other games. These databases hold balances and, in Thin
# Ice's case, the bearer tokens that ARE a player's identity.
UMask=0077

# Nothing here binds a port below 1024, so no capability is needed at all.
CapabilityBoundingSet=
AmbientCapabilities=

PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# Other processes become invisible. ProcSubset=pid is deliberately NOT set: it
# also hides /proc/stat, where Node reads CPU information.
ProtectProc=invisible

# AF_NETLINK is in the list because glibc's getaddrinfo uses it to enumerate
# interfaces; without it DNS fails in a way that looks like the network being down.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# MemoryDenyWriteExecute IS DELIBERATELY ABSENT, here as in gielinor.service: V8
# compiles JavaScript to machine code at runtime and needs pages that are
# writable and then executable, so it would not harden this service, it would
# stop it booting.

# ProtectSystem=strict was missing entirely: this could write anywhere its user
# could, /opt/cursors included. StateDirectory=cursors keeps /var/lib/cursors
# writable, which is where DB_PATH points and the only place it needs.
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
